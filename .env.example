# ==============================================================================
# QONEQT CREATORX ENVIRONMENT CONFIGURATION
# ==============================================================================
# In offline Demo Mode (default), all features work out-of-the-box with rich
# sample assets, deterministic video composition, and simulated AI agents.
# To connect live providers, provide your API keys below:

# LLM Providers (Creative Director, Script Engine, Quality Auditor)
GEMINI_API_KEY=
OPENAI_API_KEY=

# Multimodal Visual / Video Providers
RUNWARE_API_KEY=
REPLICATE_API_TOKEN=

# Acoustic Speech Synthesis (Voice Engine)
ELEVENLABS_API_KEY=

# Qoneqt Platform Integration Gateway
QONEQT_API_ENDPOINT=https://api.qoneqt.com/v1
QONEQT_CREATOR_KEY=

# Server Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
BACKEND_PORT=8000
DEMO_MODE=true
